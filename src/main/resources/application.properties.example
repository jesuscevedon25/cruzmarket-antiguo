

server.port = 8088

# Agrega esto para que Spring Boot confíe en los encabezados de Cloudflare (HTTPS)
server.forward-headers-strategy=native
# Permite cookies de sesión en entornos de proxy (como Cloudflare)
server.servlet.session.cookie.same-site=none
server.servlet.session.cookie.secure=true

spring.datasource.dbcp2.driver-class-name=com.mysql.cj.jdbc.Driver
spring.datasource.url=jdbc:mysql://HOST:PUERTO/BASE_DE_DATOS
spring.datasource.username= CONFIGURAR_LOCALMENTE
spring.datasource.password= CONFIGURAR_LOCALMENTE

spring.jpa.show-sql=true
spring.jpa.database-platform=org.hibernate.dialect.MySQL5InnoDBDialect
spring.jpa.hibernate.ddl-auto=update
spring.jpa.hibernate.use-new-id-generator-mappings=true


# Deshabilita la configuración automática de Spring Security, permitiendo que
# tu lógica de control de sesiones y autenticación tome el control.
#spring.autoconfigure.exclude=org.springframework.boot.autoconfigure.security.servlet.SecurityAutoConfiguration


# ----------------------------------------------------
# CONFIGURACIÓN DE HTTPS/SSL (MANTENIDA)
# ----------------------------------------------------
#server.ssl.enabled=false
#server.ssl.key-store=classpath:keystore.p12
#server.ssl.key-store-type=PKCS12
#server.ssl.key-alias=cruzmarket-ssl


# =========================================================
# Comentario con posible credencial omitido.
# =========================================================

spring.mail.host=smtp.gmail.com
spring.mail.port=587

# Comentario con posible credencial omitido.
spring.mail.username= CONFIGURAR_LOCALMENTE
spring.mail.password= CONFIGURAR_LOCALMENTE

spring.mail.properties.mail.smtp.auth=true
spring.mail.properties.mail.smtp.starttls.enable=true




